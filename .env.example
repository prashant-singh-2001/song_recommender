# Copy to .env (docker compose reads it automatically). All values are optional.

# Host port for the frontend container (default 3000).
FRONTEND_PORT=3000

# Backend: comma-separated browser origins allowed by CORS.
# Only needed when the frontend calls the backend directly (not via the nginx /api proxy).
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Frontend (Vite dev server / Vercel): where the browser finds the API.
# Leave unset locally (defaults to http://localhost:8000).
# VITE_API_URL=https://your-backend.example.com

# build_index.py: fetch album covers that are not already known from Last.fm.
# LASTFM_API_KEY=
